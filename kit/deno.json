{
  "name": "@ra9/tan-compose-kit",
  "version": "1.8.2",
  "exports": {
    ".": "./mod.ts",
    "./button": "./components/button.ts",
    "./input": "./components/input.ts",
    "./textarea": "./components/textarea.ts",
    "./select": "./components/select.ts",
    "./checkbox": "./components/checkbox.ts",
    "./switch": "./components/switch.ts",
    "./file": "./components/file.ts",
    "./radio-group": "./components/radio-group.ts",
    "./table": "./components/table.ts",
    "./tabs": "./components/tabs.ts",
    "./modal": "./components/modal.ts",
    "./toast": "./components/toast.ts",
    "./stat": "./components/stat.ts",
    "./card": "./components/card.ts",
    "./badge": "./components/badge.ts",
    "./skeleton": "./components/skeleton.ts",
    "./stack": "./components/stack.ts",
    "./cluster": "./components/cluster.ts",
    "./grid": "./components/grid.ts",
    "./code": "./components/code.ts",
    "./callout": "./components/callout.ts",
    "./toc": "./components/toc.ts",
    "./pagination": "./components/pagination.ts",
    "./combobox": "./components/combobox.ts",
    "./carousel": "./components/carousel.ts",
    "./accordion": "./components/accordion.ts",
    "./tooltip": "./components/tooltip.ts",
    "./popover": "./components/popover.ts",
    "./drawer": "./components/drawer.ts",
    "./progress": "./components/progress.ts",
    "./stepper": "./components/stepper.ts",
    "./avatar": "./components/avatar.ts",
    "./avatar-group": "./components/avatar-group.ts",
    "./rating": "./components/rating.ts",
    "./slider": "./components/slider.ts",
    "./chart": "./components/chart.ts",
    "./themes/tokens": "./themes/tokens.ts",
    "./themes/dark": "./themes/dark.ts",
    "./themes/bootstrap": "./themes/bootstrap.ts",
    "./themes/tailwind": "./themes/tailwind.ts",
    "./themes/material": "./themes/material.ts",
    "./themes/shadcn": "./themes/shadcn.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["dom", "esnext", "deno.ns"]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-env --allow-net --allow-write",
    "check": "deno check mod.ts components/button.ts components/input.ts components/textarea.ts components/select.ts components/checkbox.ts components/switch.ts components/file.ts components/radio-group.ts components/table.ts components/tabs.ts components/modal.ts components/toast.ts components/stat.ts components/card.ts components/badge.ts components/skeleton.ts components/stack.ts components/cluster.ts components/grid.ts components/code.ts components/callout.ts components/toc.ts components/pagination.ts components/combobox.ts components/carousel.ts components/accordion.ts components/tooltip.ts components/popover.ts components/drawer.ts components/progress.ts components/stepper.ts components/avatar.ts components/avatar-group.ts components/rating.ts components/slider.ts components/chart.ts themes/tokens.ts themes/dark.ts themes/bootstrap.ts themes/tailwind.ts themes/material.ts themes/shadcn.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test",
    "bundle": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run bundle.ts",
    "prepublish": "deno task bundle"
  },
  "fmt": {
    "exclude": ["coverage/", "dist/"]
  },
  "lint": {
    "exclude": ["coverage/", "dist/"]
  },
  "publish": {
    "exclude": [
      ".github/",
      "test/",
      "coverage/",
      "bundle.ts",
      "*.html"
    ]
  },
  "imports": {
    "@ra9/tan-compose": "jsr:@ra9/tan-compose@^1.1.0",
    "@std/assert": "jsr:@std/assert@1",
    "happy-dom": "npm:happy-dom@15"
  }
}
