{
  "name": "@ra9/tan-compose",
  "version": "0.1.3",
  "exports": "./mod.ts",
  "compilerOptions": {
    "strict": true,
    "lib": ["dom", "esnext"]
  },
  "tasks": {
    "bundle": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run bundle.ts"
  },
  "lint": {
    "exclude": ["dist/"]
  },
  "fmt": {
    "exclude": ["*.html"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "esbuild": "https://deno.land/x/esbuild@v0.20.2/mod.js",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.9"
  }
}
