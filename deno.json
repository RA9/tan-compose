{
  "name": "@ra9/tan-compose",
  "version": "0.4.0",
  "exports": "./mod.ts",
  "compilerOptions": {
    "strict": true,
    "lib": ["dom", "esnext", "deno.ns"]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-env --allow-net --allow-write",
    "test:cov": "deno test --allow-read --allow-env --allow-net --allow-write --coverage=coverage && deno coverage coverage",
    "check": "deno check mod.ts build.ts describe.ts types.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "bundle": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run bundle.ts",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test"
  },
  "lint": {
    "exclude": ["dist/", "coverage/"]
  },
  "fmt": {
    "exclude": ["*.html", "dist/", "coverage/"]
  },
  "test": {
    "exclude": ["dist/", "coverage/"]
  },
  "publish": {
    "exclude": [
      ".github/",
      ".claude/",
      "test/",
      "examples/",
      "blog/",
      "dist/",
      "coverage/",
      "*.html",
      "bundle.ts",
      "CHANGELOG.md"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "esbuild": "https://deno.land/x/esbuild@v0.20.2/mod.js",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.9",
    "happy-dom": "npm:happy-dom@15"
  }
}
